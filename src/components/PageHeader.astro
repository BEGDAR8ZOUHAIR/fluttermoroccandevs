---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="section-alt border-b border-[#c3cad4]/70 dark:border-slate-800/70">
  <div class="container-page py-14 sm:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h1 mt-4 max-w-3xl">{title}</h1>
    {description && <p class="lead mt-4 max-w-2xl">{description}</p>}
    <slot />
  </div>
</section>
