---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="h2 mt-3">{title}</h2>
    {description && <p class="lead mt-3">{description}</p>}
  </div>
  <div class="shrink-0">
    <slot />
  </div>
</div>
