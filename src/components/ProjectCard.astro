---
import { Star, ArrowUpRight } from "@lucide/astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card card-hover flex h-full flex-col">
  <div class="flex items-start justify-between gap-3">
    <span class="font-mono text-xl font-bold leading-none text-flutter-600 dark:text-flutter-300"
      >&gt;_</span
    >
    <span class="inline-flex items-center gap-1 text-sm font-medium text-amber-500">
      <Star size={15} class="fill-amber-400 text-amber-400" /> {project.stars}
    </span>
  </div>

  <h3 class="mt-4 font-mono text-base font-semibold text-slate-900 dark:text-white">
    {project.name}
  </h3>
  <p class="mt-2 flex-1 text-sm muted">{project.description}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {project.tags.map((tag) => <span class="badge">{tag}</span>)}
  </div>

  <div class="mt-5 flex items-center justify-between border-t border-[#c3cad4] pt-4 text-sm dark:border-slate-800">
    <span class="muted">{project.language} · @{project.author}</span>
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="link inline-flex items-center gap-1"
    >
      View <ArrowUpRight size={14} />
    </a>
  </div>
</article>
